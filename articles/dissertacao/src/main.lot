\contentsline {table}{\numberline {1}{\ignorespaces Representation and model lineage threaded through this dissertation, from the place-level graph-infomax embeddings to the check-in-level representation and the joint model built on it. Status of the Check2HGI representation and the joint model is \emph {submitted, under review}.}}{21}{table.caption.10}%
\contentsline {table}{\numberline {2}{\ignorespaces POI category classification results for Florida (per-category F1-score, precision, and recall, mean $\pm $ standard deviation over the 5 folds; the better of the MTL and Single values per row in bold, as in the published table).}}{37}{table.caption.24}%
\contentsline {table}{\numberline {3}{\ignorespaces Next POI category prediction results for Florida (per-category F1-score, precision, and recall, mean $\pm $ standard deviation over the 5 folds; best value per row in bold, second-best underlined).}}{38}{table.caption.25}%
